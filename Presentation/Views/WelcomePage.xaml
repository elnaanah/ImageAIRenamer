<Page x:Class="ImageAIRenamer.Presentation.Views.WelcomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="Welcome"
      FlowDirection="RightToLeft"
      Background="{StaticResource BackgroundColor}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Right Section: Instructions -->
            <StackPanel Grid.Column="0" MaxWidth="600">
                <!-- Header -->
                <TextBlock Text="🖼️ Image AI Renamer" 
                           FontSize="36" 
                           FontWeight="Bold" 
                           Foreground="{StaticResource TextPrimaryColor}"
                           Margin="0,0,0,10"/>
                <TextBlock Text="تطبيق ذكي لإدارة الصور باستخدام Google Gemini AI" 
                           FontSize="18" 
                           Foreground="{StaticResource TextSecondaryColor}"
                           Margin="0,0,0,40"/>
                
                <GroupBox Header="📖 كيفية البدء" Style="{StaticResource ModernGroupBoxStyle}">
                    <StackPanel>
                        <TextBlock Text="1. الحصول على API Key من Google AI Studio" 
                                   FontWeight="SemiBold" 
                                   FontSize="16"
                                   Foreground="{StaticResource TextPrimaryColor}"
                                   Margin="0,0,0,15"/>
                        
                        <StackPanel Margin="20,0,0,20">
                            <TextBlock Text="• افتح المتصفح واذهب إلى:" 
                                       Foreground="{StaticResource TextPrimaryColor}"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="https://aistudio.google.com/" 
                                       Foreground="{StaticResource PrimaryColor}"
                                       FontWeight="SemiBold"
                                       Margin="20,0,0,10"
                                       Cursor="Hand">
                                <TextBlock.InputBindings>
                                    <MouseBinding Gesture="LeftClick" Command="{Binding OpenAiStudioCommand}"/>
                                </TextBlock.InputBindings>
                            </TextBlock>
                            <TextBlock Text="• سجل الدخول باستخدام حساب Google الخاص بك" 
                                       Foreground="{StaticResource TextPrimaryColor}"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="• اضغط على 'Get API Key' أو 'Create API Key'" 
                                       Foreground="{StaticResource TextPrimaryColor}"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="• انسخ المفتاح واحفظه في مكان آمن" 
                                       Foreground="{StaticResource TextPrimaryColor}"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="• يمكنك إضافة عدة مفاتيح لزيادة الحد اليومي" 
                                       Foreground="{StaticResource TextPrimaryColor}"
                                       Margin="0,0,0,5"/>
                        </StackPanel>

                        <TextBlock Text="2. كيفية عمل التطبيق" 
                                   FontWeight="SemiBold" 
                                   FontSize="16"
                                   Foreground="{StaticResource TextPrimaryColor}"
                                   Margin="0,15,0,15"/>
                        
                        <StackPanel Margin="20,0,0,0">
                            <TextBlock Text="يستخدم هذا التطبيق Google Gemini AI لتحليل الصور وفهم محتواها." 
                                       Foreground="{StaticResource TextPrimaryColor}"
                                       Margin="0,0,0,10"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="يمكنك استخدام ميزتين رئيسيتين:" 
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryColor}"
                                       Margin="0,0,0,10"/>
                            <TextBlock Text="• البحث عن الصور: للعثور على صور تحتوي على محتوى معين" 
                                       Foreground="{StaticResource TextPrimaryColor}"
                                       Margin="20,0,0,5"/>
                            <TextBlock Text="• إعادة تسمية الصور: لإعادة تسمية الصور بناءً على محتواها" 
                                       Foreground="{StaticResource TextPrimaryColor}"
                                       Margin="20,0,0,5"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>

            <!-- Left Section: Features Selection -->
            <StackPanel Grid.Column="2" MaxWidth="600">
                <!-- Features Section -->
                <TextBlock Text="اختر الميزة التي تريد استخدامها:" 
                           FontSize="20" 
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryColor}"
                           Margin="0,0,0,20"/>

                <!-- Search Feature Button -->
                <Border Background="{StaticResource SurfaceColor}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="2"
                        CornerRadius="12"
                        Padding="30"
                        Cursor="Hand"
                        Margin="0,0,0,20">
                    <Border.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding NavigateToSearchCommand}"/>
                    </Border.InputBindings>
                    <StackPanel>
                        <TextBlock Text="🔍" 
                                   FontSize="48" 
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,15"/>
                        <TextBlock Text="البحث عن الصور" 
                                   FontSize="20" 
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryColor}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="ابحث عن صور تحتوي على محتوى معين مثل:" 
                                   FontSize="14"
                                   Foreground="{StaticResource TextSecondaryColor}"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="• بريد إلكتروني أو كلمة مرور" 
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryColor}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="• سيارة بمواصفات معينة" 
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryColor}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="• أي محتوى بصري آخر" 
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryColor}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Rename Feature Button -->
                <Border Background="{StaticResource SurfaceColor}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="2"
                        CornerRadius="12"
                        Padding="30"
                        Cursor="Hand">
                    <Border.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding NavigateToRenameCommand}"/>
                    </Border.InputBindings>
                    <StackPanel>
                        <TextBlock Text="✏️" 
                                   FontSize="48" 
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,15"/>
                        <TextBlock Text="إعادة تسمية الصور" 
                                   FontSize="20" 
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryColor}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="أعد تسمية الصور تلقائياً بناءً على:" 
                                   FontSize="14"
                                   Foreground="{StaticResource TextSecondaryColor}"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="• النص الموجود في الصورة" 
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryColor}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="• محتوى الصورة البصري" 
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryColor}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="• تعليمات مخصصة منك" 
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryColor}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
